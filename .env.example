# Copy to .env. Local demo mode needs none of these.

# Default is on-device demo (AsyncStorage). Switch only after configuring Supabase.
# EXPO_PUBLIC_DATA_MODE=supabase

# Public client values only. Never put the service-role key here.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server only (server/.env). Never expose this to the app.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# PORT=3001
